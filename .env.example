# ─────────────────────────────────────────────────────────────────────────────
# GateKeeper environment. Copy to .env.local and adjust.
# The mode is explicit. A production build with no mode set refuses to start.
# ─────────────────────────────────────────────────────────────────────────────
GATEKEEPER_MODE=LOCAL_DEMO            # LOCAL_DEMO | AWS_PRODUCTION

# ── LOCAL_DEMO ──────────────────────────────────────────────────────────────
# Where simulated data is persisted ("memory" = not persisted).
DEMO_DATA_FILE=.data/demo-store.json
# Optional overrides for the built-in development-only secrets.
# DEMO_SESSION_SECRET=change-me-locally
# QR_TOKEN_PEPPER=change-me-locally
# APP_ENCRYPTION_KEY=change-me-locally
# Enables POST /api/demo/reset (used by the Playwright suite). Never set in production.
# DEMO_ALLOW_RESET=true

# ── AWS_PRODUCTION: web tier (Next.js backend-for-frontend) ─────────────────
# AWS_REGION=ap-south-1
# COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX     # CDK output UserPoolId
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx   # CDK output UserPoolClientId
# API_BASE_URL=https://xxxx.execute-api.ap-south-1.amazonaws.com   # CDK output ApiUrl
# Number of reverse proxies/CDNs in front of the web tier that append to X-Forwarded-For.
# Used only for rate limiting; 0 = ignore the header (direct exposure). Default 1.
# TRUSTED_PROXY_COUNT=1

# ── AWS_PRODUCTION: Lambda functions (set automatically by CDK) ─────────────
# TABLE_NAME=...
# AUDIT_TABLE_NAME=...
# NOTIFICATION_TOPIC_ARN=...
# UPLOAD_BUCKET=...
# AUDIT_ANCHOR_BUCKET=...                       # S3 Object Lock bucket for audit-chain checkpoints
# SECRETS_PARAMETER_PREFIX=/gatekeeper/dev      # SSM SecureStrings: qr-token-pepper, encryption-key
# APP_ORIGIN=https://gatekeeper.example.com
# SMS_ENABLED=false                             # SMS is billed per message
